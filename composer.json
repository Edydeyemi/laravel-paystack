{
    "name": "edydeyemi/laravel-paystack",
    "description": "A modern, fluent PHP/Laravel 13 package for integrating Paystack payments, subscriptions, transfers, subaccounts, dedicated virtual accounts, and webhooks.",
    "keywords": [
        "laravel",
        "laravel-13",
        "paystack",
        "payments",
        "webhooks",
        "php"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "edydeyemi"
        }
    ],
    "require": {
        "php": "^8.3",
        "brick/math": "^1.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Edydeyemi\\Paystack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Edydeyemi\\Paystack\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Edydeyemi\\Paystack\\PaystackServiceProvider"
            ],
            "aliases": {
                "Paystack": "Edydeyemi\\Paystack\\Facades\\Paystack"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
